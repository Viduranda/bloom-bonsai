# Bloom & Bonsai - Environment Configuration
# Copy this file to api/.env on your server and fill in your keys.

# Google Gemini API Key (Required for live AI Chatbot, AI Vision Diagnosis, and AI Garden Designer)
GEMINI_API_KEY=

# App Environment (local | production)
APP_ENV=production

# MySQL Database Configuration (Automatically configured for AlwaysData)
DB_HOST=mysql-bloom-bonsai.alwaysdata.net
DB_NAME=bloom-bonsai_db
DB_USER=bloom-bonsai
DB_PASSWORD=
